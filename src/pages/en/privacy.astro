---
import Base from '../../layouts/Base.astro';
import { site } from '../../site';
---

<Base lang="en" page="privacy" title="Privacy" description={`Privacy policy of ${site.legalName}.`}>
  <div class="section">
    <article class="container prose">
      <h1>Privacy policy</h1>
      <p>
        We take the protection of your personal data seriously and process it in accordance
        with the Swiss Federal Act on Data Protection (FADP). This website uses no cookies, no
        tracking and no embedded third-party content.
      </p>

      <h2>Controller</h2>
      <address>
        {site.legalName}<br />
        {site.street}<br />
        {`${site.zip} ${site.city}`}<br />
        Switzerland<br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </address>

      <h2>Hosting</h2>
      <p>
        This website is served via GitHub Pages, a service of GitHub, Inc. (USA). When you visit
        the website, GitHub processes technically necessary data such as your IP address, the
        date and time of access and information about your browser in order to deliver the
        website and ensure its security. Data may be transferred to the USA in the process. For
        more information, see{' '}
        <a
          href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
          target="_blank"
          rel="noopener noreferrer">GitHub's privacy statement</a
        >.
      </p>

      <h2>Contacting us</h2>
      <p>
        If you contact us by email, we use your details solely to handle your enquiry. We do
        not pass this data on without your consent.
      </p>

      <h2>External links</h2>
      <p>
        This website links to our LinkedIn page. LinkedIn only processes data once you follow
        the link; its own privacy policy applies there.
      </p>

      <h2>Your rights</h2>
      <p>
        You have the right to information about the personal data we process about you and to
        have it corrected or deleted. Please contact us at the address above.
      </p>

      <p><small>As of November 2026. This is a translation. The German version is legally binding.</small></p>
    </article>
  </div>
</Base>
